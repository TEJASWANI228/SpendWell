# Copy to .env.local and adjust as needed.
# true (default): in-browser mock API persisted to localStorage.
# false: send requests to VITE_API_URL.
VITE_USE_MOCK=true
VITE_API_URL=http://localhost:4000/api/v1

# Optional: enable real Google sign-in (Google Identity Services).
# Create an OAuth 2.0 Web client in Google Cloud Console, add
# http://localhost:5173 as an authorised JavaScript origin, then paste the
# client id below. Leave empty to use the built-in mock Google account.
VITE_GOOGLE_CLIENT_ID=
